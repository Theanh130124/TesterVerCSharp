						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200); //neu de 201 testcase fail\r",
							"});\r",
							"\r",
							"\r",
							"//Viet test case để check dữ liệu (phải có) trả về từ BE cho FE làm\r",
							"\r",
							"pm.test(\"Test response data\" , () => {\r",
							"    let data = pm.response.json()\r",
							"    for (let d of data)\r",
							"     //giống foreach i in items\r",
							"     {\r",
							"        pm.expect(d.id).not.equal(undefined)\r",
							"        pm.expect(d.name).not.equal(undefined)\r",
							"     }\r",
							"})\r",
							"\r",
							""
						],
